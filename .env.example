# Cadena de conexión de Neon (la integración de Vercel la inyecta sola)
DATABASE_URL=postgresql://usuario:clave@ep-xxxx.neon.tech/neondb?sslmode=require

# Opcional: cierre de la feria. Las partidas creadas después no cuentan en el ranking ni en el podio.
# Con zona horaria obligatoria; si es inválida se ignora (aviso en consola).
# CIERRE_FERIA=2026-10-20T18:00:00-06:00

# Opcional pero recomendada: exige ?key=<PANEL_KEY> en /api/export y /podio (sin ella, /podio no se muestra).
# PANEL_KEY=cambia-esta-clave
